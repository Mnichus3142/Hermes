{
    "swagger": "2.0",
    "info": {
        "description": "Backend for Hermes",
        "title": "Swagger for Hermes API",
        "contact": {},
        "version": "v0.1"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
